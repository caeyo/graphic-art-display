#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba8, binding = 0) uniform writeonly image2D outImage;
layout(rgba32f, binding = 1) uniform readonly image2D stateIn;
layout(rgba32f, binding = 2) uniform writeonly image2D stateOut;

layout(std140, binding = 0) uniform FrameData {
    float time;
    float deltaTime;
    uint frame;
    uint seed;
    vec2 resolution;
    vec2 _pad1;
} uFrame;

uint hashU(uint x) {
    x ^= x >> 16u;
    x *= 0x7feb352du;
    x ^= x >> 15u;
    x *= 0x846ca68bu;
    x ^= x >> 16u;
    return x;
}

float hashF(uint n) {
    return float(hashU(uFrame.seed + n)) / 4294967295.0;
}

vec3 hsv2rgb(vec3 c) {
    vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

vec4 loadState(ivec2 coord, ivec2 size) {
    coord = clamp(coord, ivec2(0), size - ivec2(1));
    return imageLoad(stateIn, coord);
}

vec2 laplacian(ivec2 gid, ivec2 size) {
    vec2 center = loadState(gid, size).xy;
    vec2 sum = loadState(gid + ivec2(1, 0), size).xy;
    sum += loadState(gid + ivec2(-1, 0), size).xy;
    sum += loadState(gid + ivec2(0, 1), size).xy;
    sum += loadState(gid + ivec2(0, -1), size).xy;
    return sum - 4.0 * center;
}

bool hasDrawnNeighbor(ivec2 gid, ivec2 size) {
    const ivec2 offsets[4] = ivec2[](
        ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1)
    );
    for (int i = 0; i < 4; i++) {
        if (loadState(gid + offsets[i], size).w > 0.5) {
            return true;
        }
    }
    return false;
}

vec2 pickMorphology() {
    vec2 morphologies[6] = vec2[](
        vec2(0.0545, 0.062),
        vec2(0.0350, 0.0620),
        vec2(0.0367, 0.0630),
        vec2(0.0390, 0.0580),
        vec2(0.0460, 0.0630),
        vec2(0.0300, 0.0610)
    );
    return morphologies[hashU(uFrame.seed + 10u) % 6u];
}

int seedCount(vec2 fk) {
    if (fk.x < 0.042) {
        return 1 + int(hashU(uFrame.seed + 11u) % 2u);
    }
    return 3 + int(hashU(uFrame.seed + 11u) % 4u);
}

vec2 seedState(vec2 fk) {
    if (fk.x < 0.042) {
        return vec2(0.50, 0.45);
    }
    return vec2(0.50, 0.25);
}

float drawnSpreadThreshold(vec2 fk) {
    if (fk.x < 0.042) {
        return 0.04;
    }
    return 0.06;
}

vec2 seedCenter(int index) {
    if (index == 0) {
        return vec2(0.45 + hashF(20u) * 0.1, 0.45 + hashF(21u) * 0.1);
    }
    uint base = 22u + 2u * uint(index);
    return vec2(0.12 + hashF(base) * 0.76, 0.12 + hashF(base + 1u) * 0.76);
}

bool isSeeded(vec2 uv, vec2 fk) {
    int count = seedCount(fk);
    for (int i = 0; i < 6; i++) {
        if (i >= count) {
            break;
        }
        if (length(uv - seedCenter(i)) < 0.04) {
            return true;
        }
    }
    return false;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (gid.x >= size.x || gid.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(gid) + 0.5) / vec2(size);
    vec2 fk = pickMorphology();
    float feed = fk.x;
    float kill = fk.y;

    const float dt = 1.0;
    const float diffuseU = 0.16;
    const float diffuseV = 0.08;

    vec4 prev = uFrame.frame == 0u ? vec4(1.0, 0.0, 0.0, 0.0) : loadState(gid, size);
    vec2 uvState;
    float drawn = prev.w;

    if (uFrame.frame == 0u) {
        uvState = vec2(1.0, 0.0);
        drawn = 0.0;

        if (isSeeded(uv, fk)) {
            uvState = seedState(fk);
            drawn = 1.0;
        }
    } else {
        vec2 state = prev.xy;
        vec2 lap = laplacian(gid, size);
        float reaction = state.x * state.y * state.y;
        float u = state.x + (diffuseU * lap.x - reaction + feed * (1.0 - state.x)) * dt;
        float v = state.y + (diffuseV * lap.y + reaction - (feed + kill) * state.y) * dt;
        uvState = clamp(vec2(u, v), 0.0, 1.0);

        if (drawn < 0.5 && uvState.y > drawnSpreadThreshold(fk) && hasDrawnNeighbor(gid, size)) {
            drawn = 1.0;
        }
    }

    imageStore(stateOut, gid, vec4(uvState, 0.0, drawn));

    vec3 col = vec3(0.0);
    if (drawn > 0.5 && uvState.y > 0.03) {
        float hue = fract(uFrame.time * 0.12);
        float brightness = clamp(uvState.y * 2.2, 0.0, 1.0);
        col = hsv2rgb(vec3(hue, 0.88, brightness));
    }

    imageStore(outImage, gid, vec4(col, 1.0));
}
